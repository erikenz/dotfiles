{
  "agentMode": "auto",
  "allowNonWorkspaceAccess": true,
  "editor": "env NVIM_APPNAME=astronvim nvim",
  "editorMode": "vim",
  "enableTerminalSandbox": true,
  "keybindings": {
    "list.next": "alt+j",
    "list.previous": "alt+k",
    "pane.focus_left": "none",
    "pane.focus_right": "none",
    "pane.focus_up": "none",
    "pane.focus_down": "none"
  },
  "model": "Gemini 3.8 Flash (Medium)",
  "notifications": true,
  "permissions": {
    "allow": [
      "command(*)",
      "read_file(*)",
      "write_file(*)"
    ],
    "deny": [
      "command(sudo *)",
      "command(su *)",
      "command(rm -rf /)",
      "command(rm -rf /*)",
      "command(rm -rf ~*)",
      "command(rm -rf *)",
      "command(dd *)",
      "command(mkfs*)",
      "command(chmod -R 777*)",
      "command(chmod 777*)",
      "command(shutdown*)",
      "command(reboot*)",
      "command(poweroff*)",
      "command(git reset --hard*)",
      "command(git push *--force*)",
      "command(git push *-f*)",
      "command(git push --force*)",
      "command(git push -f*)"
    ]
  },
  "plugins": [
    "cc-safety-net"
  ],
  "showFeedbackSurvey": false,
  "statusline": {
    "showModel": true,
    "showTokenCount": true,
    "showMcpStatus": true,
    "theme": "catppuccin"
  },
  "toolPermission": "always-proceed",
  "trustedWorkspaces": [
    "/home/erikzen/.config/hypr",
    "/home/erikzen/.config/nvim",
    "/home/erikzen/.local/share/chezmoi",
    "/home/erikzen/Projects/race-control-studio",
    "/home/erikzen/Projects/balcon-padel",
    "/home/erikzen",
    "/home/erikzen/.gemini/config",
    "/home/erikzen/.gemini",
    "/home/erikzen/Projects/javaClases",
    "/home/erikzen/.config/zed",
    "/home/erikzen/Projects/biome-plugin-payload",
    "/home/erikzen/.config/astronvim",
    "/home/erikzen/Projects/watchdeck",
    "/home/erikzen/Projects/mcp-ctl",
    "/home/erikzen/Projects/watchdeck/.delta/worktrees/wr6fddbfeda1/watchdeck",
    "/home/erikzen/Projects/balcon-padel/.delta/worktrees/5a77tsjeffat/balcon-padel"
  ],
  "vimInsertFirst": true
}