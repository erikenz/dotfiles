{
  "agentMode": "accept-edits",
  "allowNonWorkspaceAccess": true,
  "editor": "env NVIM_APPNAME=astronvim nvim",
  "editorMode": "vim",
  "enableTelemetry": false,
  "enableTerminalSandbox": true,
  "keybindings": {
    "list.next": "alt+j",
    "list.previous": "alt+k",
    "pane.focus_left": "none",
    "pane.focus_right": "none",
    "pane.focus_up": "none",
    "pane.focus_down": "none"
  },
  "model": "Gemini 3.7 Flash (High)",
  "notifications": true,
  "permissions": {
    "allow": [
      "command(find)",
      "command(grep)",
      "command(qs)",
      "command(git log)",
      "command(xargs)",
      "command(sort)",
      "command(uniq)",
      "command(head)",
      "command(git status)",
      "command(cat)",
      "command(sed)",
      "command(git rev-parse)",
      "command(pnpm check)",
      "command(pnpm typecheck)",
      "command(cd)",
      "command(tail)",
      "command(ls)",
      "command(bunx)",
      "command(git diff)",
      "command(pnpm --filter web gen:types)",
      "command(pnpm test:int)",
      "command(docker ps)",
      "command(pnpm run)",
      "command(pnpm fix)",
      "command(pnpm test)",
      "command(pnpm dlx)",
      "command(pnpm install)",
      "command(pnpm --filter=web test)",
      "command(pnpm build)",
      "command(bun tsc)",
      "command(npx)",
      "command(pnpm tsc)",
      "command(pnpm doctor)",
      "command(pnpm --filter web exec tsc --noEmit)",
      "command(pnpm dlx react-doctor@latest --json --yes \u003e/tmp/diagnostics.json)",
      "command(pnpm --filter web typecheck)",
      "command(mpcli)",
      "mcp(sentry/*)",
      "command(pnpm gen:types)",
      "command(git show)",
      "unsandboxed(herdr)",
      "unsandboxed(sleep)",
      "mcp(chrome-devtools/list_pages)",
      "mcp(chrome-devtools/navigate_page)",
      "mcp(chrome-devtools/take_snapshot)",
      "mcp(chrome-devtools/list_console_messages)",
      "mcp(chrome-devtools/list_network_requests)",
      "mcp(chrome-devtools/get_network_request)",
      "mcp(chrome-devtools/evaluate_script)",
      "command(pnpm gen)",
      "unsandboxed(pnpm gen)",
      "mcp(chrome-devtools/new_page)",
      "mcp(chrome-devtools/select_page)",
      "mcp(chrome-devtools/close_page)",
      "mcp(chrome-devtools/click)",
      "execute_url(localhost)",
      "mcp(chrome-devtools/resize_page)",
      "unsandboxed(pnpm --filter web typecheck)",
      "read_url(github.com)",
      "mcp(chrome-devtools/take_screenshot)",
      "read_url(raw.githubusercontent.com)",
      "mcp(chrome-devtools/wait_for)",
      "mcp(chrome-devtools/type_text)",
      "mcp(chrome-devtools/press_key)",
      "command(sq)",
      "unsandboxed(sq)",
      "mcp(chrome-devtools/fill)",
      "unsandboxed(bunx ultracite fix)",
      "unsandboxed(bunx ultracite check)",
      "unsandboxed(pnpm typecheck)",
      "read_url(supabase.com)",
      "read_url(docs.dokploy.com)",
      "mcp(chrome-devtools/fill_form)",
      "unsandboxed(pnpm --filter=web exec tsc --noEmit)",
      "unsandboxed(git show)",
      "unsandboxed(head)",
      "mcp(chrome-devtools/emulate)",
      "unsandboxed(pnpm --filter @repo/react-schedule typecheck)",
      "mcp(chrome-devtools/drag)",
      "unsandboxed(git status)",
      "unsandboxed(pnpm run typecheck)",
      "unsandboxed(git log)"
    ],
    "deny": [
      "command(rm -rf *)",
      "command(git push --force*)",
      "command(git reset --hard*)",
      "command(sudo *)",
      "command(dd *)",
      "command(mkfs*)",
      "command(chmod 777*)"
    ]
  },
  "plugins": [
    "cc-safety-net"
  ],
  "showFeedbackSurvey": false,
  "statusline": {
    "showModel": true,
    "showTokenCount": true,
    "showMcpStatus": true,
    "theme": "catppuccin"
  },
  "trustedWorkspaces": [
    "/home/erikzen/.config/hypr",
    "/home/erikzen/.config/nvim",
    "/home/erikzen/.local/share/chezmoi",
    "/home/erikzen/Projects/race-control-studio",
    "/home/erikzen/Projects/balcon-padel",
    "/home/erikzen",
    "/home/erikzen/.gemini/config",
    "/home/erikzen/.gemini",
    "/home/erikzen/Projects/javaClases",
    "/home/erikzen/.config/zed",
    "/home/erikzen/Projects/biome-plugin-payload",
    "/home/erikzen/.config/astronvim"
  ],
  "vimInsertFirst": true
}
