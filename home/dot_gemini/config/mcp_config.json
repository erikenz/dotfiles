{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest", "--browser-url=http://127.0.0.1:9222"]
    },
    "sentry": {
      "serverUrl": "https://mcp.sentry.dev/mcp"
    },
    "shadcn": {
      "command": "npx",
      "args": ["shadcn@latest", "mcp"]
    },
    "next-devtools": {
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@latest"]
    },
    "balcon-padel-dev": {
      "command": "/home/erikzen/.local/bin/mcp-run",
      "args": [
        "balcon-padel-dev"
      ]
    },
    "posthog": {
      "serverUrl": "https://mcp.posthog.com/mcp"
    },
    "mcp-server-playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--browser", "chrome", "--cdp-endpoint", "http://localhost:9222"]
    }
  }
}
