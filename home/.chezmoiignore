# chezmoi ignore rules (.chezmoiignore)
# Patterns match target paths relative to home directory (~/)

# --- Universal Ignores ---
**/node_modules/**
node_modules/**
.cache/**
**/.cache/**
**/.DS_Store
*.swp
*.bak
*~

# --- Volatile runtime logs, session history, tokens, SSH keys, and cache ---
.ssh/id_*
.ssh/known_hosts*
.config/herdr/*.log
.config/herdr/session*.json
.config/herdr/.plugins.lock
.config/fish/fish_variables
.gemini/config/projects/**
.gemini/antigravity-cli/*.log
.gemini/antigravity-cli/brain/**
.gemini/antigravity-cli/conversations/**
.gemini/antigravity-cli/history.jsonl
.gemini/antigravity-cli/antigravity-oauth-token
.gemini/antigravity-cli/mcp_oauth_tokens.json

# --- Source repository helper files and docs ---
.chezmoiroot
.gitattributes
bootstrap.sh
README.md

{{- if eq .chezmoi.os "android" }}
# --- Desktop/GUI configurations (Ignored on Termux & Headless) ---
.config/hypr/**
.config/ghostty/**
.config/gtk-3.0/**
.config/gtk-4.0/**
.config/input-remapper-2/**
.config/kdeglobals
.config/mchose/**
.config/noctalia/**
.config/private_dolphinrc
.config/qt5ct/**
.config/shelly/**
.config/swash/**
.config/uwsm/**
.config/zathura/**
.config/zed/**
.config/environment.d/**
{{- end }}

# --- Pi coding agent (auth, model store, sessions, caches, package store) ---
.config/pi/agent/auth.json
.config/pi/agent/models-store.json
.config/pi/agent/sessions/**
.config/pi/agent/web-search-cache/**
.config/pi/agent/npm/**

# --- Coding-agent credentials & local state outside .config ---
.local/share/opencode/auth.json
.local/share/opencode/*.db*
.local/share/opencode/sessions/**
.local/share/opencode/log/**
.local/share/opencode/tmp/**
.config/opencode/auth.json
.config/opencode/log/**
.config/cc-safety-net/**

# --- Classic credential carriers ---
.netrc
.npmrc
.pypirc
.docker/config.json
.config/gh/hosts.yml
.config/gcloud/**
.kube/config
.kube/**
.aws/**
.gnupg/**
.local/share/mise/installs/**

# --- OpenCode account & MCP credentials (live keys found on this machine) ---
.local/share/opencode/account.json
.local/share/opencode/mcp-auth.json
.local/share/opencode/mcp-oauth.json
.local/share/opencode/oauth.json
