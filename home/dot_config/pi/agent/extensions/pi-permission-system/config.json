{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": false,
  "doublePressToConfirm": false,
  "permission": {
    "*": "allow",
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "delete": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/*": "deny",
      "~/.aws/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.netrc": "deny",
      "~/.config/gh/hosts.yml": "deny",
      "~/.config/gcloud/*": "deny",
      "~/.kube/config": "deny",
      "~/.docker/config.json": "deny",
      "~/.config/pi/agent/auth.json": "deny",
      "~/.config/opencode/auth.json": "deny"
    },
    "bash": {
      "*": "allow",
      "sudo *": "deny",
      "su *": "deny",
      "rm -rf *": "ask",
      "rm -r *": "ask",
      "rm -fr *": "ask",
      "rm -rf /": "deny",
      "rm -rf ~": "deny",
      "rm -rf ~/": "deny",
      "rm -rf ~/*": "deny",
      "rm -rf ~*": "deny",
      "rm -rf $HOME": "deny",
      "rm -rf $HOME/": "deny",
      "rm -rf $HOME/*": "deny",
      "rm -rf $HOME*": "deny",
      "rm -rf /home": "deny",
      "rm -rf /home/": "deny",
      "rm -rf /home/erikzen": "deny",
      "rm -rf /home/erikzen/": "deny",
      "rm -rf /boot*": "deny",
      "rm -rf /etc*": "deny",
      "rm -rf /usr*": "deny",
      "rm -rf /bin*": "deny",
      "rm -rf /sbin*": "deny",
      "rm -rf /lib*": "deny",
      "rm -rf /sys*": "deny",
      "rm -rf /proc*": "deny",
      "rm -rf /dev*": "deny",
      "rm -rf /var*": "deny",
      "rm -rf /root*": "deny",
      "rm -r /": "deny",
      "rm -r ~": "deny",
      "rm -r ~/": "deny",
      "rm -r ~*": "deny",
      "rm -r $HOME*": "deny",
      "rm -r /home/erikzen": "deny",
      "rm -r /home/erikzen/": "deny",
      "rm -r /boot*": "deny",
      "rm -r /etc*": "deny",
      "rm -r /usr*": "deny",
      "rm -r /bin*": "deny",
      "rm -r /sbin*": "deny",
      "rm -r /lib*": "deny",
      "rm -r /sys*": "deny",
      "rm -r /proc*": "deny",
      "rm -r /dev*": "deny",
      "rm -r /var*": "deny",
      "rm -r /root*": "deny",
      "rm -fr /": "deny",
      "rm -fr ~*": "deny",
      "rm -fr $HOME*": "deny",
      "rm -fr /home/erikzen": "deny",
      "rm -fr /boot*": "deny",
      "rm -fr /etc*": "deny",
      "rm -fr /usr*": "deny",
      "rm -fr /bin*": "deny",
      "rm -fr /sbin*": "deny",
      "rm -fr /lib*": "deny",
      "rm -fr /sys*": "deny",
      "rm -fr /proc*": "deny",
      "rm -fr /dev*": "deny",
      "rm -fr /var*": "deny",
      "rm -fr /root*": "deny",
      "rm -rf ~/Projects/*": "allow",
      "rm -rf /home/erikzen/Projects/*": "allow",
      "rm -rf $HOME/Projects/*": "allow",
      "rm -r ~/Projects/*": "allow",
      "rm -r /home/erikzen/Projects/*": "allow",
      "rm -r $HOME/Projects/*": "allow",
      "rm -fr ~/Projects/*": "allow",
      "rm -fr /home/erikzen/Projects/*": "allow",
      "rm -fr $HOME/Projects/*": "allow",
      "rm -f ~/Projects/*": "allow",
      "rm -f /home/erikzen/Projects/*": "allow",
      "rm -f $HOME/Projects/*": "allow",
      "rm ~/Projects/*": "allow",
      "rm /home/erikzen/Projects/*": "allow",
      "rm $HOME/Projects/*": "allow",
      "rm -rf node_modules*": "allow",
      "rm -rf */node_modules*": "allow",
      "rm -rf dist*": "allow",
      "rm -rf */dist*": "allow",
      "rm -rf build*": "allow",
      "rm -rf */build*": "allow",
      "rm -rf .next*": "allow",
      "rm -rf */.next*": "allow",
      "rm -rf .turbo*": "allow",
      "rm -rf */.turbo*": "allow",
      "rm -rf .cache*": "allow",
      "rm -rf */.cache*": "allow",
      "rm -rf .delta*": "allow",
      "rm -rf */.delta*": "allow",
      "rm -rf /tmp/*": "allow",
      "rm -r /tmp/*": "allow",
      "rm -fr /tmp/*": "allow",
      "rm -f /tmp/*": "allow",
      "rm /tmp/*": "allow",
      "dd *": "deny",
      "mkfs*": "deny",
      "chmod -R 777*": "deny",
      "chmod 777*": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      "poweroff*": "deny",
      "git reset --hard*": "ask",
      "git push *--force*": "ask",
      "git push * -f *": "ask",
      "git push * -f": "ask",
      "git push *-f *": "ask",
      "git push *-f": "ask",
      "git push *--force-with-lease*": "allow",
      "git push *--force*main*": "deny",
      "git push *--force*master*": "deny",
      "git push *main*--force*": "deny",
      "git push *master*--force*": "deny",
      "git push *-f *main*": "deny",
      "git push *-f *master*": "deny",
      "git push *main* -f*": "deny",
      "git push *master* -f*": "deny",
      "git push *main*-f*": "deny",
      "git push *master*-f*": "deny",
      "git push *--force-with-lease*main*": "deny",
      "git push *--force-with-lease*master*": "deny",
      "git push *main*--force-with-lease*": "deny",
      "git push *master*--force-with-lease*": "deny",
      "npm *": {
        "action": "deny",
        "reason": "This workspace is pinned to pnpm. Use pnpm instead."
      }
    },
    "external_directory_read": {
      "*": "allow"
    },
    "external_directory_write": {
      "*": "ask",
      "/tmp/*": "allow",
      "~/Projects/*": "allow",
      "/home/erikzen/Projects/*": "allow",
      "$HOME/Projects/*": "allow",
      "~/.t3/*": "allow",
      "/home/erikzen/.t3/*": "allow",
      "~/.agents/*": "allow",
      "/home/erikzen/.agents/*": "allow",
      "~/.config/pi/*": "allow",
      "/home/erikzen/.config/pi/*": "allow"
    },
    "mcp": {
      "*": "allow"
    },
    "skill": {
      "*": "allow"
    }
  }
}