{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4-flash",
  "small_model": "gemini/gemini-3.6-flash",
  "plugin": [
    "cc-safety-net"
  ],
  "permission": {
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "list_dir": "allow",
    "edit": "allow",
    "create": "allow",
    "delete": "ask",
    "bash": {
      "*": "ask",
      "rm -rf *": "deny",
      "git reset --hard*": "deny",
      "git push --force*": "deny",
      "sudo *": "deny",
      "dd *": "deny",
      "mkfs*": "deny",
      "chmod 777*": "deny"
    }
  },
  "mcp": {
    "hub": {
      "type": "local",
      "command": ["npx", "-y", "mcp-remote", "http://localhost:37373/mcp"],
      "timeout": 20000
    }
  }
}
