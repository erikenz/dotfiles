{
  "mcpServers": {
    "sentry": {
      "url": "https://mcp.sentry.dev/mcp"
    },
    "shadcn": {
      "command": "npx",
      "args": [
        "shadcn@latest",
        "mcp"
      ]
    },
    "next-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "next-devtools-mcp@latest"
      ]
    },
    "mcp-server-playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--browser-url",
        "http://127.0.0.1:9222"
      ]
    },
    "posthog": {
      "url": "https://mcp.posthog.com/mcp"
    },
    "dokploy": {
      "command": "npx",
      "args": ["-y", "@dokploy/mcp"],
      "env": {
        "DOKPLOY_URL": "${cmd: ~/.local/bin/get-secret 'hostinger vps' DOKPLOY_URL}",
        "DOKPLOY_API_KEY": "${cmd: ~/.local/bin/get-secret 'hostinger vps' DOKPLOY_API_KEY}",
        "DOKPLOY_TOOL_PRESET": "minimal"
      }
    }
  }
}