#!/usr/bin/env bash
set -euo pipefail

if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -S "$XDG_RUNTIME_DIR/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi

if ! busctl --user status org.mpris.MediaPlayer2.YoutubeMusic >/dev/null 2>&1; then
    exit 0
fi

DIR="${XDG_RUNTIME_DIR:-/tmp}/ytm-volume"
mkdir -p "$DIR"
LOCK="$DIR/lock"
STATE="$DIR/state"
CONFIG_FILE="$HOME/.config/YouTube Music/config.json"

exec 200>"$LOCK"
flock -x 200

ACTION="${1:-up}"
STEP="${2:-1}"

DELTA="$STEP"
if [ "$ACTION" = "down" ] || [ "$ACTION" = "-" ]; then
    DELTA="-$STEP"
fi

NOW=$(date +%s%3N)
CUR=""

parse_vol() {
    local v="$1"
    if [[ "$v" =~ ^0*1(\.0+)?$ ]]; then
        echo 100; return
    fi
    if [[ "$v" =~ ^0+(\.0+)?$ ]]; then
        echo 0; return
    fi
    if [[ "$v" =~ ^0*\.([0-9]{1,2}) ]]; then
        local dec="${BASH_REMATCH[1]}"
        if [ ${#dec} -eq 1 ]; then
            echo "$(( 10#$dec * 10 ))"
        else
            echo "$(( 10#$dec ))"
        fi
        return
    fi
    echo 0
}

format_vol() {
    local n="$1"
    if [ "$n" -ge 100 ]; then
        echo "1.0"
    elif [ "$n" -le 0 ]; then
        echo "0.0"
    elif [ "$n" -lt 10 ]; then
        echo "0.0$n"
    else
        echo "0.$n"
    fi
}

# 1. Read last known volume from state
if [ -f "$STATE" ]; then
    read -r LAST_TIME LAST_VOL < "$STATE" || true
    if [ -n "${LAST_VOL:-}" ]; then
        CUR="$LAST_VOL"
    fi
fi

# 2. If no state (e.g. after reboot), fall back to saved volume in config.json
if [ -z "$CUR" ] && [ -f "$CONFIG_FILE" ]; then
    CONFIG_VOL=$(jq -r '.plugins["precise-volume"].savedVolume // empty' "$CONFIG_FILE" 2>/dev/null || true)
    if [ -n "$CONFIG_VOL" ] && [ "$CONFIG_VOL" != "null" ]; then
        CUR="$CONFIG_VOL"
    fi
fi

# 3. If still empty, fall back to MPRIS D-Bus
if [ -z "$CUR" ]; then
    RAW=$(busctl --user get-property org.mpris.MediaPlayer2.YoutubeMusic /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player Volume 2>/dev/null || true)
    if [ -n "$RAW" ]; then
        VAL="${RAW#d }"
        CUR=$(parse_vol "$VAL")
    else
        CUR=50
    fi
fi

NEW=$((CUR + DELTA))
if [ "$NEW" -gt 100 ]; then
    NEW=100
elif [ "$NEW" -lt 0 ]; then
    NEW=0
fi

echo "$NOW $NEW" > "$STATE"

NEW_FLOAT=$(format_vol "$NEW")
busctl --user set-property org.mpris.MediaPlayer2.YoutubeMusic /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player Volume d "$NEW_FLOAT" >/dev/null 2>&1 || true
