#!/usr/bin/env fish
# Usage: get-secret <item-name> [field-name]
set -l item $argv[1]
set -l field $argv[2]
if test -z "$field"
    set field password
end

if test -z "$item"
    echo "usage: get-secret <item-name> [field-name]" >&2
    exit 1
end

# 1. Check env variable override (e.g. OPENCODE_API_KEY for 'opencode')
set -l env_var (string upper (string replace -a '-' '_' $item))
if set -q $env_var
    echo $$env_var
    exit 0
end

# 2. Try rbw (keyring-backed Bitwarden CLI)
if command -q rbw
    set -l cmd rbw get
    if test "$field" != password
        set -a cmd --field $field
    end
    set -a cmd $item
    set -l out (timeout 15 $cmd 2>/dev/null)
    if test $status -ne 0; or not string length -q -- $out
        # Vault locked or stale agent: unlock (pinentry prompt if needed) and retry once.
        timeout 60 rbw unlock </dev/null >/dev/null 2>&1
        set -l out (timeout 15 $cmd 2>/dev/null)
        if test $status -eq 0; and string length -q -- $out
            string trim -- $out
            exit 0
        end
        # Surface why rbw failed for callers that capture stderr (e.g. the dev on-init check).
        set -l err (timeout 15 $cmd 2>&1 >/dev/null | string collect)
        if string length -q -- $err
            string trim -- $err | head -1 >&2
        end
    else
        string trim -- $out
        exit 0
    end
end

# 3. Try official bw CLI fallback
if command -q bw; and set -q BW_SESSION
    if test "$field" = password
        set -l out (timeout 15 bw get password $item 2>/dev/null)
        if test $status -eq 0; and string length -q -- $out
            string trim -- $out
            exit 0
        end
    end
end

exit 1
