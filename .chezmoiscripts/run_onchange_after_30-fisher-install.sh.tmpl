#!/usr/bin/env bash
# Fish plugins manifest hash: {{ include "dot_config/fish/fish_plugins" | sha256sum }}
set -euo pipefail

if command -v fish &>/dev/null; then
  echo "==> [Fisher] Ensuring Fisher is installed and updating fish plugins..."
  fish -c "
    if not type -q fisher
      curl -sL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source && fisher install jorgebucaran/fisher
    end
    fisher update
  " 2>/dev/null || echo "Warning: Fisher plugin update encountered an issue, skipping."
  echo "==> [Fisher] Fish plugins synchronized."
fi
